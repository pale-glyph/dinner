# PostgreSQL image and connection settings
POSTGRES_VERSION=16-alpine
POSTGRES_DB=dinner
POSTGRES_USER=dinner
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Local service defaults
ASPNETCORE_ENVIRONMENT=Development
DINNER_WEB_PORT=3000
AGENT_GATEWAY_PORT=18081
HOUSEHOLD_SERVICE_PORT=18082
PANTRY_SERVICE_PORT=18083
NEXT_PUBLIC_PANTRY_API_URL=http://localhost:18083
NEXT_PUBLIC_RECIPE_API_URL=http://localhost:18084
NEXT_PUBLIC_AGENT_GATEWAY_API_URL=http://localhost:18081
RECIPE_SERVICE_PORT=18084
NUTRITION_DATA_SERVICE_PORT=18085
MEAL_PLANNING_SERVICE_PORT=18086
SHOPPING_LIST_SERVICE_PORT=18087

# Optional in-house Agent Platform connection. Leave blank to use local gateway fixture mode.
AGENT_PLATFORM_BASE_URL=
AGENT_PLATFORM_PROJECT_ID=
AGENT_PLATFORM_AGENT_ID=
AGENT_PLATFORM_WEBHOOK_SECRET=
